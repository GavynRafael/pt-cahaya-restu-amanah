---
import { getWhatsAppConsultationUrl } from '../lib/constants';

const waUrl = getWhatsAppConsultationUrl();
---

<section id="beranda" class="relative min-h-[88vh] flex items-center overflow-hidden bg-cra-black bg-grid-pattern pt-12 pb-20">
  <!-- Ambient Gold Light Effect -->
  <div class="absolute inset-0 bg-radial-gold pointer-events-none" aria-hidden="true"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Content & Strong Typography -->
      <div class="lg:col-span-7 flex flex-col justify-center space-y-8">
        
        <!-- Company Identity Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-cra-surface border border-cra-gold/30 w-fit">
          <span class="w-2 h-2 rounded-full bg-cra-gold animate-pulse"></span>
          <span class="text-xs font-semibold uppercase tracking-widest text-cra-gold">
            Biro Jasa STNK Seluruh Indonesia
          </span>
        </div>

        <!-- Main Heading & Subtitle -->
        <div class="space-y-4">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
            Solusi Legalitas & Dokumen Kendaraan Anda di <br class="hidden sm:inline" />
            <span class="gold-gradient-text">PT CAHAYA RESTU AMANAH</span>
          </h1>
          <p class="text-base sm:text-lg text-cra-silver/90 max-w-2xl font-normal leading-relaxed pt-2">
            Layanan biro jasa profesional, transparan, dan terpercaya untuk pengurusan Pajak, STNK 5 Tahunan, Balik Nama, hingga Mutasi kendaraan bermotor di seluruh wilayah Indonesia.
          </p>
        </div>

        <!-- Primary & Secondary CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-bold text-base text-cra-black bg-gradient-to-r from-cra-gold-light via-cra-gold to-cra-gold-dark hover:brightness-110 shadow-lg shadow-cra-gold/20 transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-cra-gold text-center"
          >
            <svg class="w-5 h-5 mr-2.5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.769.814 2.796.814 3.181 0 5.767-2.586 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm3.393 8.163c-.144.405-.837.774-1.17.823-.312.045-.694.072-2.073-.487-1.764-.714-2.898-2.484-2.986-2.602-.088-.118-.711-.947-.711-1.805 0-.858.45-1.28.61-1.455.161-.176.353-.221.47-.221.118 0 .235.001.338.006.107.006.251-.041.393.3.144.347.491 1.2.534 1.288.044.089.073.192.015.309-.059.118-.088.192-.176.294-.088.103-.186.229-.265.308-.089.088-.182.184-.078.362.103.177.458.756.982 1.223.676.602 1.246.788 1.423.876.176.088.279.074.382-.045.103-.117.441-.513.559-.689.117-.176.235-.147.397-.088.161.059 1.028.485 1.205.573.176.088.294.132.338.206.044.074.044.428-.1 1.033z"/>
            </svg>
            Konsultasi Sekarang
          </a>
          
          <a
            href="#layanan"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl font-semibold text-base text-cra-silver hover:text-white bg-cra-surface/90 hover:bg-cra-card border border-cra-border hover:border-cra-gold/50 transition-all focus:outline-none focus:ring-2 focus:ring-cra-gold text-center"
          >
            Lihat 9 Layanan Kami
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>

        <!-- Verified Quick Facts (No false claims) -->
        <div class="pt-6 border-t border-cra-border/70 grid grid-cols-2 sm:grid-cols-3 gap-6 text-sm">
          <div>
            <div class="text-cra-gold font-bold text-base">Seluruh Indonesia</div>
            <div class="text-cra-muted text-xs mt-0.5">Jangkauan Antar Wilayah</div>
          </div>
          <div>
            <div class="text-cra-gold font-bold text-base">Senin – Sabtu</div>
            <div class="text-cra-muted text-xs mt-0.5">08.00 – 16.00 WIB</div>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <div class="text-cra-gold font-bold text-base">Kantor Mojokerto</div>
            <div class="text-cra-muted text-xs mt-0.5">Depan Polres Mojokerto</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Minimalist Elegant Geometric Ornament (NO CAR/SUBSTITUTE PHOTOS) -->
      <div class="lg:col-span-5 flex items-center justify-center relative min-h-[360px] sm:min-h-[440px]">
        <!-- Decorative Ambient Rings -->
        <div class="relative w-full max-w-[380px] aspect-square flex items-center justify-center">
          
          <!-- Outer Subtle Thin Golden Orbit -->
          <div class="absolute inset-0 rounded-full border border-cra-gold/15 animate-[spin_40s_linear_infinite]" aria-hidden="true"></div>
          
          <!-- Secondary Dashed Orbit -->
          <div class="absolute inset-6 rounded-full border border-dashed border-cra-gold/25" aria-hidden="true"></div>
          
          <!-- Rotated Diamond Outer Frame -->
          <div class="absolute inset-10 rotate-45 rounded-2xl border border-cra-gold/30 bg-cra-dark/40 backdrop-blur-sm" aria-hidden="true"></div>
          
          <!-- Inner Diamond Frame with Gold Border Glow -->
          <div class="absolute inset-16 -rotate-12 rounded-xl border border-cra-gold/40 bg-gradient-to-tr from-cra-black/90 to-cra-surface/90 shadow-2xl" aria-hidden="true"></div>

          <!-- Central Architectural Monogram Emblem -->
          <div class="relative z-10 w-36 h-36 rounded-2xl bg-gradient-to-b from-cra-surface to-cra-black border border-cra-gold/60 p-5 flex flex-col items-center justify-center text-center shadow-[0_0_40px_rgba(212,175,55,0.15)]">
            <!-- Subtle Gold Geometric Crest -->
            <svg class="w-8 h-8 text-cra-gold mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
            <span class="text-xs uppercase tracking-widest text-cra-silver font-semibold">LEGALITAS</span>
            <span class="text-sm font-extrabold text-cra-gold tracking-tight">& AMANAH</span>
          </div>

          <!-- Minimal Accent Nodes -->
          <div class="absolute top-4 right-10 w-2.5 h-2.5 rounded-full bg-cra-gold shadow-[0_0_10px_#D4AF37]" aria-hidden="true"></div>
          <div class="absolute bottom-6 left-12 w-2 h-2 rounded-full bg-cra-gold/70" aria-hidden="true"></div>
          <div class="absolute top-1/2 left-0 w-1.5 h-1.5 rounded-full bg-cra-silver/40" aria-hidden="true"></div>
          <div class="absolute top-1/2 right-0 w-1.5 h-1.5 rounded-full bg-cra-gold/40" aria-hidden="true"></div>

        </div>
      </div>

    </div>
  </div>
</section>
