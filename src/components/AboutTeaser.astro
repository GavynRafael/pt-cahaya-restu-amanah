---
import { COMPANY, getWhatsAppConsultationUrl } from '../lib/constants';

const waUrl = getWhatsAppConsultationUrl();
---

<section id="tentang-kami" class="py-24 bg-cra-black relative overflow-hidden border-t border-cra-border/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Narrative Content -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cra-surface border border-cra-gold/30 text-cra-gold text-xs font-semibold tracking-wider uppercase">
          Profil Perusahaan
        </div>
        
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug">
          Biro Jasa Terpercaya Berbadan Hukum Resmi
        </h2>
        
        <p class="text-cra-silver/85 text-base sm:text-lg leading-relaxed">
          <strong class="text-white font-semibold">{COMPANY.name}</strong> adalah biro jasa pengurusan dokumen kendaraan bermotor yang melayani kebutuhan perorangan maupun perusahaan di seluruh Indonesia. Berbasis di Mojosari, Mojokerto, kami hadir untuk memberikan kemudahan, kepastian proses, dan transparansi administrasi tanpa repot.
        </p>

        <p class="text-cra-silver/80 text-base leading-relaxed">
          Kami senantiasa memegang teguh amanah dalam menjaga keaslian dan keamanan berkas Anda. Setiap tahapan pengurusan diproses langsung melalui kantor Samsat dan instansi berwenang terkait sesuai prosedur hukum yang berlaku di Indonesia.
        </p>

        <!-- Principles Grid (Strictly factual) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
          <div class="p-4 rounded-xl bg-cra-surface border border-cra-border flex items-start gap-3.5">
            <div class="w-9 h-9 rounded-lg bg-cra-gold/10 text-cra-gold flex items-center justify-center shrink-0 border border-cra-gold/30">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-bold text-white">Legalitas Resmi</h4>
              <p class="text-xs text-cra-muted mt-0.5">Seluruh dokumen diproses secara sah melalui Samsat dan Polda.</p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-cra-surface border border-cra-border flex items-start gap-3.5">
            <div class="w-9 h-9 rounded-lg bg-cra-gold/10 text-cra-gold flex items-center justify-center shrink-0 border border-cra-gold/30">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-bold text-white">Lokasi Kantor Jelas</h4>
              <p class="text-xs text-cra-muted mt-0.5">Sidotopo, Mojosari (tepat di depan Polres Mojokerto).</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Operational Info Card -->
      <div class="lg:col-span-5">
        <div class="bg-gradient-to-br from-cra-surface via-cra-dark to-cra-black rounded-3xl p-8 border border-cra-gold/30 shadow-2xl relative">
          <div class="flex items-center justify-between border-b border-cra-border/80 pb-6 mb-6">
            <div>
              <span class="text-xs font-semibold text-cra-gold uppercase tracking-wider">Informasi Operasional</span>
              <h3 class="text-xl font-bold text-white mt-1">Kantor & Layanan</h3>
            </div>
            <div class="w-10 h-10 rounded-full bg-cra-gold/10 border border-cra-gold/40 flex items-center justify-center text-cra-gold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
          </div>

          <div class="space-y-5 text-sm">
            <div>
              <div class="text-xs text-cra-muted font-medium">Alamat Kantor:</div>
              <p class="text-white font-medium mt-1 leading-relaxed">
                {COMPANY.address}
              </p>
            </div>

            <div>
              <div class="text-xs text-cra-muted font-medium">Jam Pelayanan:</div>
              <p class="text-white font-medium mt-1">
                {COMPANY.operationalHours}
              </p>
              <p class="text-xs text-cra-muted mt-0.5">
                {COMPANY.holidayNote}
              </p>
            </div>

            <div>
              <div class="text-xs text-cra-muted font-medium">Kontak Admin Resmi:</div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
                <div class="p-3 rounded-lg bg-cra-black border border-cra-border">
                  <span class="text-[11px] text-cra-gold font-semibold uppercase">Admin 1</span>
                  <div class="text-white font-mono font-bold mt-0.5">{COMPANY.admin1}</div>
                </div>
                <div class="p-3 rounded-lg bg-cra-black border border-cra-border">
                  <span class="text-[11px] text-cra-gold font-semibold uppercase">Admin 2</span>
                  <div class="text-white font-mono font-bold mt-0.5">{COMPANY.admin2}</div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-cra-border/80">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center py-3 px-4 rounded-xl font-bold text-sm text-cra-black bg-gradient-to-r from-cra-gold-light via-cra-gold to-cra-gold-dark hover:brightness-110 shadow-md shadow-cra-gold/15 transition-all"
            >
              Hubungi Admin Sekarang
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
